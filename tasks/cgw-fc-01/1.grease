#!/usr/bin/env grease
if (int($#) !== 12) { echo 'requires EXPORTER HEAD AICI HEAD KITCHEN HEAD IKE HEAD ICK GREASE EVIDENCE SOURCE_ID' >&2; exit 2 }
var repo = $1
var repo_head = $2
var aici_root = $3
var aici_head = $4
var kitchen_root = $5
var kitchen_head = $6
var ike_root = $7
var ike_head = $8
var compiler = $9
var grease = ${10}
var evidence = ${11}
var source_id = ${12}
test "$repo_head" = "$source_id"
test "$(uname -s)" = Linux
test "$(uname -m)" = x86_64
test "$repo" = "$(realpath -- "$repo")"
test "$aici_root" = "$(realpath -- "$aici_root")"
test "$kitchen_root" = "$(realpath -- "$kitchen_root")"
test "$ike_root" = "$(realpath -- "$ike_root")"
test "$evidence" = "$(realpath -- "$evidence")"
test "$(stat -c %a -- "$evidence")" = 700
test ! -e "$evidence/ike.tsv"
test "$(git -C "$repo" rev-parse HEAD)" = "$repo_head"
test "$(git -C "$aici_root" rev-parse HEAD)" = "$aici_head"
test "$(git -C "$kitchen_root" rev-parse HEAD)" = "$kitchen_head"
test "$(git -C "$ike_root" rev-parse HEAD)" = "$ike_head"
git -C "$repo" diff --quiet
git -C "$aici_root" diff --quiet
git -C "$kitchen_root" diff --quiet
git -C "$ike_root" diff --quiet
test -x "$compiler"
test -x "$grease"
test -x "$ike_root/ike"
test "$(sha256sum "$grease" | cut -d ' ' -f 1)" = 7e31cd05b7a9d8fb2a4a9e003a7f3fcb0159138506d17f0fb28da8cbe22aa85c
var task = "$kitchen_root/tasks/cgw-fc-01"
var identity = "$(sha256sum "$task/Ikefile" | cut -d ' ' -f 1)"
export CGW_EXPORTER_ROOT="$repo" CGW_AICI_ROOT="$aici_root" CGW_ICK="$compiler" CGW_EVIDENCE="$evidence"
export CGW_FLAGS="-std=c11 -O2 -Wall -Wextra -Werror -pedantic -fno-link-libatomic -DCGW_CAPTURE_SOURCE_IDENTITY=\"$source_id\""
cd -- "$task"
IKE_RECIPE_RUNNER="$grease" IKE_RECEIPT="$evidence/ike.tsv" IKE_IKEFILE_IDENTITY="sha256:$identity" "$ike_root/ike" capture
sha256sum "$repo/native/cgw_capture.c" "$repo/native/cgw_json.c" "$aici_root/native-capture/check.c" "$compiler" "$grease" "$ike_root/ike" "$task/Ikefile" "$evidence/independent-check"
printf 'PASS\tpinned-source-Kitchen-Ike-fixture-procedure\nAndroid\tNOT_RUN\nphysical_A1_C67\tNOT_RUN\nproduction_controller\tNOT_ACCEPTED\nvisible_delivery_receipt\tNOT_ACCEPTED\n'
