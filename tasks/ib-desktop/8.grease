#!/usr/bin/env grease
# Linux generated-program and C-ABI qualification, after native ICK qualification.
if (int($#) !== 6) {
  echo 'requires MODE ABS_IB ABS_AICI ABS_COMPILER_BUNDLE ABS_OUTPUT ABS_ICK_STAGE' >&2
  exit 2
}
var mode = $1
var ib = $2
var aici = $3
var bundle = $4
var output = $5
var stage = $6

proc absolute_path (value) {
  if (not value.startsWith('/') or value.contains(u'\n') or value.contains(u'\r') or value.contains(u'\t')) {
    echo 'requires an absolute path without record separators' >&2
    exit 2
  }
}
func native_word (value) {
  return ("u'" ++ value.replace(u'\\', u'\\\\').replace("'", "\\'") ++ "'")
}
absolute_path "$ib"
absolute_path "$aici"
absolute_path "$bundle"
absolute_path "$output"
absolute_path "$stage"
if env LC_ALL=C grep -q '[^ -~]' <<< "$output" {
  echo 'BLOCKED_UNICODE_BUILD_PATH: compiler 94dfd99bd misquotes non-ASCII Chez compilation paths; select an explicit ASCII build root' >&2
  exit 2
}
test "$(uname -s)" = Linux
test "$(uname -m)" = x86_64
if (mode === 'run') {
  test ! -e "$output/Ikefile"
} elif (mode === 'native') {
  for label in source ttc library mutant {
    test ! -e "$output/$label"
  }
}
mkdir -p -- "$output"
var compiler = "$bundle/bin/idric"
var ick = "$stage/bin/gcc"

if (mode === 'run') {
  var grease = get(ENV, 'GREASE') or ''
  var ike = get(ENV, 'IKE') or ''
  var self = "$[ENV.KITCHEN_ROOT]/tasks/ib-desktop/8.grease"
  absolute_path "$grease"
  absolute_path "$ike"
  absolute_path "$self"
  var recipe = native_word(grease) ++ " " ++ native_word(self) ++ " native " ++ native_word(ib) ++ " " ++ native_word(aici) ++ " " ++ native_word(bundle) ++ " " ++ native_word(output) ++ " " ++ native_word(stage)
  write -- 'native-foundation depends on' "    $recipe" > "$output/Ikefile"
  sha256sum "$output/Ikefile" > "$output/Ikefile.sha256"
  var identity_line = "$(cat "$output/Ikefile.sha256")"
  var identity = identity_line.split(' ')[0]
  cd -- "$output"
  env IKE_RECIPE_RUNNER="$grease" IKE_RECEIPT="$output/ike.tsv" IKE_IKEFILE_IDENTITY="sha256:$identity" "$ike" native-foundation
  sha256sum --check "$output/Ikefile.sha256"
} elif (mode === 'native') {
  test "$("$ick" -dumpmachine)" = x86_64-pc-linux-gnu
  "$stage/qualification/glyphs-O0" > "$output/ick-O0.txt"
  "$stage/qualification/glyphs-O2" > "$output/ick-O2.txt"
  sha256sum --check "$stage/host-runtime.sha256" > "$output/runtime-unchanged.txt"
  sha256sum "$ick" "$stage/libexec/gcc/x86_64-pc-linux-gnu/17.0.0/cc1" > "$output/ick.sha256"
  cp -- "$stage/host-runtime-packages.tsv" "$output/host-runtime-packages.tsv"
  "$ick" --version > "$output/ick-version.txt"
  "$compiler" --version > "$output/idric-version.txt"
  sha256sum "$ib/native/linux/ib_platform.c" "$ib/native/linux/ib_platform.h" "$ib/src/IB/Linux/Platform.idric" "$ib/src/IB/LongViewTask.idric" "$ib/src/IB/LongViewLifecycle.idric" "$ib/src/IB/FragmentStore.idric" "$ib/src/IB/Occurrence.idric" "$ib/src/IB/Strand.idric" "$aici/examples/autogenerated/ib-shared-core/SharedCoreOracle.idric" "$aici/examples/autogenerated/ib-shared-core/NativeFoundationOracle.idric" > "$output/input.sha256"
  git -C "$ib" rev-parse HEAD > "$output/ib-source.txt"
  git -C "$aici" rev-parse HEAD > "$output/aici-source.txt"
  mkdir -p -- "$output/source" "$output/library" "$output/mutant"
  cp -R -- "$ib/src/IB" "$output/source/IB"
  cp -- "$aici/examples/autogenerated/ib-shared-core/SharedCoreOracle.idric" "$output/source/SharedCoreOracle.idric"
  cp -- "$aici/examples/autogenerated/ib-shared-core/NativeFoundationOracle.idric" "$output/source/NativeFoundationOracle.idric"
  "$ick" -fno-link-libatomic -std=c17 -Wall -Wextra -Werror -fPIC -shared -O2 "$ib/native/linux/ib_platform.c" -o "$output/source/libib_linux.so"
  if "$ick" -fno-link-libatomic -std=c17 -D__ANDROID__ -c "$ib/native/linux/ib_platform.c" -o "$output/android.o" > "$output/android-guard.stdout" 2> "$output/android-guard.stderr" {
    echo 'Android was incorrectly accepted as Linux desktop' >&2
    exit 3
  }
  grep -F IB_LINUX_X86_64_REQUIRED "$output/android-guard.stderr" > "$output/android-guard.rejected.txt"
  file "$output/source/libib_linux.so" > "$output/library.abi.txt"
  readelf -h "$output/source/libib_linux.so" > "$output/library.elf.txt"
  ldd "$output/source/libib_linux.so" > "$output/library.dependencies.txt"
  if grep -q 'not found' "$output/library.dependencies.txt" {
    echo 'unresolved native dependency' >&2
    exit 3
  }
  cd -- "$output/source"
  "$compiler" --build-dir "$output/ttc" --no-color --codegen chez NativeFoundationOracle.idric -o ib-linux-foundation-check > "$output/generation.stdout" 2> "$output/generation.stderr"
  if grep -q '^Error:' "$output/generation.stdout" "$output/generation.stderr" {
    echo 'compiler reported an error despite returning success' >&2
    exit 3
  }
  var executable = "$output/ttc/exec/ib-linux-foundation-check"
  var app = "$output/ttc/exec/ib-linux-foundation-check_app"
  test -x "$executable"
  test -f "$app/libib_linux.so"
  sha256sum "$executable" "$app/ib-linux-foundation-check.ss" "$app/ib-linux-foundation-check.so" "$app/libib_linux.so" > "$output/executable.sha256"
  cd -- "$output"
  pwd > "$output/launch-directory.txt"
  "$bundle/bin/idric-env" "$executable" > "$output/clean.txt" 2> "$output/clean.stderr"
  test "$(wc -l < "$output/clean.txt")" = 46
  test "$(grep -c '=True$' "$output/clean.txt")" = 46
  cp -- "$app/libib_linux.so" "$output/library/libib_linux.so"
  sed 's/return (int)bytes;/return (int)bytes + 1;/' "$ib/native/linux/ib_platform.c" > "$output/mutant/ib_platform.c"
  cp -- "$ib/native/linux/ib_platform.h" "$output/mutant/ib_platform.h"
  grep -F 'return (int)bytes + 1;' "$output/mutant/ib_platform.c" > "$output/mutation.txt"
  "$ick" -fno-link-libatomic -std=c17 -Wall -Wextra -Werror -fPIC -shared -O2 "$output/mutant/ib_platform.c" -o "$app/libib_linux.so"
  if "$bundle/bin/idric-env" "$executable" > "$output/mutant.txt" 2> "$output/mutant.stderr" {
    echo 'native byte-count mutant was accepted' >&2
    exit 3
  }
  grep -Fx 'native-empty-bytes=False' "$output/mutant.txt" > "$output/mutant.rejected.txt"
  mv -- "$app/libib_linux.so" "$output/mutant/libib_linux.so"
  if "$bundle/bin/idric-env" "$executable" > "$output/missing-library.txt" 2> "$output/missing-library.stderr" {
    echo 'missing native library was accepted' >&2
    exit 3
  }
  grep -F libib_linux "$output/missing-library.stderr" > "$output/missing-library.rejected.txt"
  cp -- "$output/library/libib_linux.so" "$app/libib_linux.so"
  "$bundle/bin/idric-env" "$executable" > "$output/recovery.txt" 2> "$output/recovery.stderr"
  cmp "$output/clean.txt" "$output/recovery.txt"
  var relocated = "$output/relocated it's 東京"
  cp -R -- "$output/ttc/exec" "$relocated"
  "$bundle/bin/idric-env" "$relocated/ib-linux-foundation-check" > "$output/relocated.txt" 2> "$output/relocated.stderr"
  cmp "$output/clean.txt" "$output/relocated.txt"
  sha256sum --check "$output/executable.sha256" > "$output/executable-restored.txt"
  sha256sum --check "$output/input.sha256" > "$output/input-unchanged.txt"
  printf 'semantic\tPASS\nlinux-generated-program\tPASS\nnative-ffi\tPASS\nelf-only-application\tNOT_RUN\ngraphical\tNOT_RUN\nnetwork\tNOT_RUN\ndurable-disk-recovery\tNOT_RUN\nandroid-runtime\tNOT_RUN\nphysical-device\tNOT_RUN\n' > "$output/evidence.tsv"
  echo 'native-foundation=PASS; graphical-desktop=NOT_RUN'
} else {
  echo 'mode must be native or run' >&2
  exit 2
}
