#!/usr/bin/env grease
# Repeat the existing native consumer qualification without normalizing outputs.
if (int($#) !== 7) {
  echo 'requires ABS_IB ABS_AICI ABS_COMPILER_BUNDLE ABS_NEW_OUTPUT ABS_ICK_STAGE ABS_GREASE ABS_IKE' >&2
  exit 2
}
var ib = $1
var aici = $2
var bundle = $3
var output = $4
var stage = $5
var grease = $6
var ike = $7

proc absolute_path (value) {
  if (not value.startsWith('/') or value.contains(u'\n') or value.contains(u'\r') or value.contains(u'\t')) {
    echo 'requires an absolute path without record separators' >&2
    exit 2
  }
}
absolute_path "$ib"
absolute_path "$aici"
absolute_path "$bundle"
absolute_path "$output"
absolute_path "$stage"
absolute_path "$grease"
absolute_path "$ike"
test "$(uname -s)" = Linux
test "$(uname -m)" = x86_64
if env LC_ALL=C grep -q '[^ -~]' <<< "$output" {
  echo 'BLOCKED_UNICODE_BUILD_PATH: the selected native recipe requires an ASCII build root' >&2
  exit 2
}
if test -e "$output" {
  echo 'refusing an existing repeat-build output root' >&2
  exit 2
}
if test -L "$output" {
  echo 'refusing a linked repeat-build output root' >&2
  exit 2
}
test -x "$grease"
test -x "$ike"
test -x "$bundle/bin/idric"
test -s "$bundle/payload.sha256"
test -s "$stage/host-runtime.sha256"
var self = "$(realpath -- "$0")"
var task = "$(dirname -- "$self")"
var kitchen = "$(realpath -- "$task/../..")"
var native_recipe = "$task/8.grease"
test -s "$native_recipe"
git -C "$ib" rev-parse HEAD
git -C "$aici" rev-parse HEAD
mkdir -- "$output"
git -C "$ib" rev-parse HEAD > "$output/ib-source.txt"
git -C "$aici" rev-parse HEAD > "$output/aici-source.txt"
git -C "$kitchen" rev-parse HEAD > "$output/kitchen-source.txt"
uname -srm > "$output/host.txt"
sha256sum "$self" "$native_recipe" "$grease" "$ike" "$bundle/bin/idric" "$bundle/payload.sha256" "$stage/host-runtime.sha256" > "$output/material.sha256"
find "$ib/src/IB" "$ib/native/linux" "$aici/examples/autogenerated/ib-shared-core" -type f -print0 > "$output/source-paths.nul"
sort -z "$output/source-paths.nul" > "$output/source-paths.sorted.nul"
xargs -0 sha256sum < "$output/source-paths.sorted.nul" > "$output/source.sha256"
cd -- "$bundle"
sha256sum --check payload.sha256 > "$output/bundle-before.txt"
sha256sum --check "$stage/host-runtime.sha256" > "$output/runtime-before.txt"
for attempt in first second {
  env GREASE="$grease" IKE="$ike" KITCHEN_ROOT="$kitchen" "$grease" "$native_recipe" run "$ib" "$aici" "$bundle" "$output/$attempt" "$stage" > "$output/$attempt.stdout" 2> "$output/$attempt.stderr"
  find "$ib/src/IB" "$ib/native/linux" "$aici/examples/autogenerated/ib-shared-core" -type f -print0 > "$output/$attempt-source-paths.nul"
  sort -z "$output/$attempt-source-paths.nul" > "$output/$attempt-source-paths.sorted.nul"
  cmp "$output/source-paths.sorted.nul" "$output/$attempt-source-paths.sorted.nul"
  sha256sum --check "$output/source.sha256" > "$output/$attempt-source-unchanged.txt"
  sha256sum --check "$output/material.sha256" > "$output/$attempt-material-unchanged.txt"
  test "$(git -C "$ib" rev-parse HEAD)" = "$(cat "$output/ib-source.txt")"
  test "$(git -C "$aici" rev-parse HEAD)" = "$(cat "$output/aici-source.txt")"
}
sha256sum --check payload.sha256 > "$output/bundle-after.txt"
sha256sum --check "$stage/host-runtime.sha256" > "$output/runtime-after.txt"
printf 'component\tfirst_sha256\tsecond_sha256\tresult\n' > "$output/components.tsv"
var different = false
for component in launcher generated-scheme compiled-chez native-library {
  var relative = 'ttc/exec/ib-linux-foundation-check'
  if (component === 'generated-scheme') {
    setvar relative = 'ttc/exec/ib-linux-foundation-check_app/ib-linux-foundation-check.ss'
  } elif (component === 'compiled-chez') {
    setvar relative = 'ttc/exec/ib-linux-foundation-check_app/ib-linux-foundation-check.so'
  } elif (component === 'native-library') {
    setvar relative = 'ttc/exec/ib-linux-foundation-check_app/libib_linux.so'
  }
  var first = "$output/first/$relative"
  var second = "$output/second/$relative"
  if test ! -s "$first" {
    printf '%s\tMISSING_OR_EMPTY\tUNKNOWN\tFAIL\n' "$component" >> "$output/components.tsv"
    echo "first consumer component missing or empty: $component" >&2
    setvar different = true
    continue
  }
  if test ! -s "$second" {
    printf '%s\tUNKNOWN\tMISSING_OR_EMPTY\tFAIL\n' "$component" >> "$output/components.tsv"
    echo "second consumer component missing or empty: $component" >&2
    setvar different = true
    continue
  }
  var first_line = "$(sha256sum -- "$first")"
  var second_line = "$(sha256sum -- "$second")"
  var first_hash = first_line.split(' ')[0]
  var second_hash = second_line.split(' ')[0]
  if cmp -- "$first" "$second" > "$output/$component.compare.txt" 2>&1 {
    printf '%s\t%s\t%s\tPASS\n' "$component" "$first_hash" "$second_hash" >> "$output/components.tsv"
  } else {
    printf '%s\t%s\t%s\tFAIL\n' "$component" "$first_hash" "$second_hash" >> "$output/components.tsv"
    echo "consumer bytes differ: $component" >&2
    setvar different = true
  }
}
cat "$output/components.tsv"
if (different) {
  printf 'linux-consumer-byte-reproducibility\tFAIL\n' > "$output/reproducibility.tsv"
  exit 4
}
printf 'linux-consumer-byte-reproducibility\tPASS\n' > "$output/reproducibility.tsv"
echo 'linux-consumer-byte-reproducibility=PASS'
