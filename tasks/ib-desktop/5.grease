#!/usr/bin/env grease
# Independent source checking through Kitchen; no bootstrap or acquisition here.
if (int($#) !== 5) {
  echo 'requires MODE ABSOLUTE_IB ABSOLUTE_AICI ABSOLUTE_COMPILER_BUNDLE ABSOLUTE_OUTPUT' >&2
  exit 2
}
var mode = $1
var ib = $2
var aici = $3
var bundle = $4
var output = $5
var compiler = "$bundle/bin/idric"

proc absolute_path (value) {
  if (not value.startsWith('/') or value.contains(u'\n') or value.contains(u'\r') or value.contains(u'\t')) {
    echo 'requires an absolute path without record separators' >&2
    exit 2
  }
}
func native_word (value) {
  return ("u'" ++ value.replace(u'\\', u'\\\\').replace("'", "\\'") ++ "'")
}
absolute_path "$ib"
absolute_path "$aici"
absolute_path "$bundle"
absolute_path "$output"
test "$(uname -s)" = Linux
test "$(uname -m)" = x86_64
if (mode === 'check') {
  for label in clean disposable-tab utf16-one-unit unbound-source recovery ttc {
    test ! -e "$output/$label"
  }
} elif (mode === 'run') {
  test ! -e "$output/Ikefile"
}
"$compiler" --version
mkdir -p -- "$output"
var oracle = "$aici/examples/autogenerated/ib-shared-core/SharedCoreOracle.idric"

proc snapshot (label) {
  mkdir -p -- "$output/$label"
  cp -R -- "$ib/src/IB" "$output/$label/IB"
  cp -- "$oracle" "$output/$label/SharedCoreOracle.idric"
}

proc check_and_evaluate (label, expected) {
  var root = "$output/$label"
  cd -- "$root"
  "$compiler" --build-dir "$output/ttc/$label" --no-color --check SharedCoreOracle.idric > "$output/$label.typecheck.txt" 2>&1
  "$compiler" --build-dir "$output/ttc/$label" --quiet --no-banner --no-color --client acceptance_passed SharedCoreOracle.idric > "$output/$label.result.txt" 2> "$output/$label.evaluator.stderr"
  var observed = "$(cat "$output/$label.result.txt")"
  if (observed !== expected) {
    echo "unexpected semantic result for $label: $observed" >&2
    exit 3
  }
  "$compiler" --build-dir "$output/ttc/$label" --quiet --no-banner --no-color --client acceptance_results SharedCoreOracle.idric > "$output/$label.cases.txt" 2> "$output/$label.cases.stderr"
  echo "$label=$observed"
}

if (mode === 'check') {
  sha256sum "$ib/src/IB/LongViewTask.idric" "$ib/src/IB/LongViewLifecycle.idric" "$ib/src/IB/FragmentStore.idric" "$oracle" > "$output/input.sha256"
  git -C "$ib" rev-parse HEAD > "$output/ib-source.txt"
  git -C "$aici" rev-parse HEAD > "$output/aici-source.txt"
  snapshot clean
  check_and_evaluate clean True
  snapshot disposable-tab
  sed -i 's/^persistence_for ordinary_tab = durable_browser_task$/persistence_for ordinary_tab = renderer_lifetime_only/' "$output/disposable-tab/IB/LongViewTask.idric"
  grep -Fx 'persistence_for ordinary_tab = renderer_lifetime_only' "$output/disposable-tab/IB/LongViewTask.idric" > "$output/disposable-tab.mutation.txt"
  check_and_evaluate disposable-tab False
  grep -F '("ordinary-tab-is-durable", False)' "$output/disposable-tab.cases.txt" > "$output/disposable-tab.rejected.txt"
  snapshot utf16-one-unit
  sed -i 's/^utf16_width character = if ord character < 65536 then 1 else 2$/utf16_width character = if ord character < 65536 then 1 else 1/' "$output/utf16-one-unit/IB/FragmentStore.idric"
  grep -Fx 'utf16_width character = if ord character < 65536 then 1 else 1' "$output/utf16-one-unit/IB/FragmentStore.idric" > "$output/utf16-one-unit.mutation.txt"
  check_and_evaluate utf16-one-unit False
  grep -F '("utf16-boundary-4", False)' "$output/utf16-one-unit.cases.txt" > "$output/utf16-one-unit.rejected.txt"
  snapshot unbound-source
  sed -i 's/if not (source_binding admitted ≟ source_binding graph.source) ||/if False ||/' "$output/unbound-source/IB/FragmentStore.idric"
  grep -F 'if False ||' "$output/unbound-source/IB/FragmentStore.idric" > "$output/unbound-source.mutation.txt"
  check_and_evaluate unbound-source False
  grep -F '("changed-decoded-revision-refused", False)' "$output/unbound-source.cases.txt" > "$output/unbound-source.rejected.txt"
  snapshot recovery
  check_and_evaluate recovery True
  sha256sum --check "$output/input.sha256" > "$output/input-unchanged.txt"
  printf 'semantic\tPASS\nnative-executable\tNOT_RUN\ngraphical\tNOT_RUN\nnetwork\tNOT_RUN\nandroid-runtime\tNOT_RUN\nphysical-device\tNOT_RUN\n' > "$output/evidence.tsv"
} elif (mode === 'run') {
  var grease = get(ENV, 'GREASE') or ''
  var ike = get(ENV, 'IKE') or ''
  absolute_path "$grease"
  absolute_path "$ike"
  var self = "$[ENV.KITCHEN_ROOT]/tasks/ib-desktop/5.grease"
  absolute_path "$self"
  # Single-quote each data path for Grease's source-file recipe protocol.
  var recipe = native_word(grease) ++ " " ++ native_word(self) ++ " check " ++ native_word(ib) ++ " " ++ native_word(aici) ++ " " ++ native_word(bundle) ++ " " ++ native_word(output)
  write -- "shared-core depends on" "    $recipe" > "$output/Ikefile"
  sha256sum "$output/Ikefile" > "$output/Ikefile.sha256"
  var identity_line = "$(cat "$output/Ikefile.sha256")"
  var identity = identity_line.split(' ')[0]
  cd -- "$output"
  env IKE_RECIPE_RUNNER="$grease" IKE_RECEIPT="$output/ike.tsv" IKE_IKEFILE_IDENTITY="sha256:$identity" "$ike" shared-core
  sha256sum --check "$output/Ikefile.sha256"
} else {
  echo 'mode must be check or run' >&2
  exit 2
}
