#!/usr/bin/env grease
# Candidate Kitchen task. Source-file quoting follows tasks/ib-desktop/7.grease.
# No acquisition, fallback compiler, publishing or physical-device effects.
if (int($#) !== 9) {
  echo 'requires MODE ABS_DIRICHLET ABS_COMPILER ABS_OUTPUT ABS_GREASE ABS_IKE BASE_HEAD RELATIVE_SOURCE SOURCE_SHA256' >&2
  exit 2
}
var mode = $1
var source = $2
var compiler = $3
var output = $4
var grease = $5
var ike = $6
var source_head = $7
var relative_source = $8
var source_sha256 = $9
var self = "$(realpath -- "$0")"

proc absolute_path (value) {
  if (not value.startsWith('/') or value.contains(u'\n') or value.contains(u'\r') or value.contains(u'\t')) {
    echo 'requires an absolute path without record separators' >&2
    exit 2
  }
}
func native_word (value) {
  return ("u'" ++ value.replace(u'\\', u'\\\\').replace("'", "\\'") ++ "'")
}
absolute_path "$source"
absolute_path "$compiler"
absolute_path "$output"
absolute_path "$grease"
absolute_path "$ike"
test "$(uname -s)" = Linux
test "$(uname -m)" = x86_64
test "$(git -C "$source" rev-parse HEAD)" = "$source_head"
var source_root = "$(realpath -- "$source")"
var source_file = "$(realpath -- "$source/$relative_source")"
if (not source_file.startsWith(source_root ++ '/') or not relative_source.endsWith('.idric')) {
  echo 'source must be an Idric file contained by the named repository' >&2
  exit 2
}
var module_name = "$(basename -- "$relative_source" .idric)"
printf '%s  %s\n' "$source_sha256" "$source_file" | sha256sum --check --status
test -x "$compiler"
test -x "$grease"
test -x "$ike"

if (mode === 'run') {
  test ! -e "$output"
  mkdir -p -- "$output"
  var recipe = native_word(grease) ++ " " ++ native_word(self) ++ " check " ++ native_word(source) ++ " " ++ native_word(compiler) ++ " " ++ native_word(output) ++ " " ++ native_word(grease) ++ " " ++ native_word(ike) ++ " " ++ native_word(source_head) ++ " " ++ native_word(relative_source) ++ " " ++ native_word(source_sha256)
  write -- 'native-proof depends on' "    $recipe" > "$output/Ikefile"
  sha256sum "$output/Ikefile" > "$output/Ikefile.sha256"
  var identity_line = "$(cat "$output/Ikefile.sha256")"
  var identity = identity_line.split(' ')[0]
  cd -- "$output"
  env IKE_RECIPE_RUNNER="$grease" IKE_RECEIPT="$output/ike.tsv" IKE_IKEFILE_IDENTITY="sha256:$identity" "$ike" native-proof
  sha256sum --check "$output/Ikefile.sha256"
} elif (mode === 'check') {
  test -d "$output"
  test ! -e "$output/snapshot"
  test ! -e "$output/build"
  mkdir -- "$output/snapshot"
  cp -- "$source_file" "$output/snapshot/$module_name.idric"
  sha256sum "$output/snapshot/$module_name.idric" "$compiler" "$grease" "$ike" "$self" > "$output/inputs.sha256"
  git -C "$source" rev-parse HEAD > "$output/base-head.txt"
  git -C "$source" status --short -- "$relative_source" > "$output/source-worktree-status.txt"
  printf 'candidate-source\t%s\nsource-sha256\t%s\nbase-head-is-not-a-dirty-candidate-commit\ttrue\n' "$relative_source" "$source_sha256" > "$output/source-identity.tsv"
  "$compiler" --version > "$output/compiler-version.txt" 2>&1
  cd -- "$output/snapshot"
  "$compiler" --build-dir "$output/build" --no-color --check "$module_name.idric" > "$output/compiler.stdout" 2> "$output/compiler.stderr"
  # A historical compiler can return zero on a rejected source. Require new TTC
  # from this fresh build and leave independent false-witness rejection separate.
  find "$output/build" -type f -name "$module_name.ttc" -print > "$output/ttc-paths.txt"
  test "$(wc -l < "$output/ttc-paths.txt")" -eq 1
  var ttc = "$(cat "$output/ttc-paths.txt")"
  test -s "$ttc"
  sha256sum "$ttc" > "$output/ttc.sha256"
  sha256sum --check "$output/inputs.sha256" > "$output/inputs-unchanged.txt"
  printf 'native-source-check\tPASS\nindependent-aici\tNOT_RUN\ntrusted-dispatch\tNOT_VERIFIED\nplatform-delivery\tNOT_VERIFIED\nphysical-device\tNOT_RUN\n' > "$output/evidence.tsv"
  cat "$output/evidence.tsv"
} else {
  echo 'mode must be run or check' >&2
  exit 2
}
