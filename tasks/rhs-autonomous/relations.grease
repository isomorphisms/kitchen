#!/usr/bin/env grease
set -e
if (int($#) !== 4) { echo 'requires absolute RHS root, fresh evidence, Ithon and AI-CI native checker' >&2; exit 2 }
var root = $1
var evidence = $2
var ithon = $3
var checker = $4
var ick = ENV.ICK
if (not root.startsWith('/') or not evidence.startsWith('/') or not ithon.startsWith('/') or not checker.startsWith('/') or not ick.startsWith('/')) {
  echo 'native relation acceptance requires absolute paths' >&2
  exit 2
}
test -x "$ithon"
test -x "$ick"
test -s "$checker"
test -s "$root/examples/autogenerated/behavior-evaluation/relation-observer.c"
"$ithon" "$root/examples/autogenerated/behavior-evaluation/test-relations.pi" selftest
"$ithon" "$root/examples/autogenerated/behavior-evaluation/test-finding.pi"
mkdir -- "$evidence"
cp "$root/examples/autogenerated/behavior-evaluation/relation-observer.c" "$evidence/relation-observer.c"
"$ick" -fno-link-libatomic -std=c11 -Wall -Wextra -Wpedantic -O0 "$evidence/relation-observer.c" -o "$evidence/native-O0"
"$ithon" "$root/examples/autogenerated/behavior-evaluation/test-relations.pi" "$evidence/native-O0" "$evidence/cases-O0" "$root"
"$ick" -fno-link-libatomic -std=c11 -Wall -Wextra -Wpedantic -O2 "$evidence/relation-observer.c" -o "$evidence/native-O2"
"$ithon" "$root/examples/autogenerated/behavior-evaluation/test-relations.pi" "$evidence/native-O2" "$evidence/cases-O2" "$root"
"$ithon" "$checker" "$root" "$evidence"
