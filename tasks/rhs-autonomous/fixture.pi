import sys
from pathlib import Path
environment ∈ dict[str, str] ← os.environ
arguments ∈ list[str] ← sys.argv
trace ∈ str ← environment["RHS_KITCHEN_FIXTURE_LOG"]
before ∈ str ← ""
if Path(trace).exists():
