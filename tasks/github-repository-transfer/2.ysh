#!/usr/bin/env grease
# Kitchen transfer candidate 2. Grease entrypoint; POSIX-compatible command subset.
# Takes SOURCE_OWNER REPOSITORY DESTINATION_ORGANIZATION EXPECTED_GITHUB_LOGIN.
set -eu

fail() {
    printf 'GitHub repository transfer: %s\n' "$*" >&2
    exit 1
}

lower() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

same_name() {
    [ "$(lower "$1")" = "$(lower "$2")" ]
}

[ "$#" -eq 4 ] || fail 'usage: transfer SOURCE_OWNER REPOSITORY DESTINATION_ORGANIZATION EXPECTED_GITHUB_LOGIN'
source_owner=$1
repository=$2
destination_organization=$3
expected_login=$4

for component in "$source_owner" "$repository" "$destination_organization" "$expected_login"; do
    case $component in
        ''|[!A-Za-z0-9]*|*[!A-Za-z0-9_.-]*) fail "invalid GitHub name component: $component" ;;
    esac
done

command -v gh >/dev/null 2>&1 || fail 'gh is not installed'
# For interactive user transfers, refuse silently selected environment tokens.
unset GH_TOKEN GITHUB_TOKEN
gh auth status --hostname github.com >/dev/null 2>&1 || fail 'gh is not authenticated to github.com'
login=$(gh api user --jq '.login') || fail 'cannot read authenticated GitHub login'
same_name "$login" "$expected_login" || fail "authenticated as $login, expected $expected_login"

requested_source=$source_owner/$repository
source_full=$(gh api "repos/$requested_source" --jq '.full_name') || fail "cannot read source $requested_source"
source_id=$(gh api "repos/$requested_source" --jq '.id') || fail "cannot read source repository ID"
[ -n "$source_id" ] && [ "$source_id" != null ] || fail 'source repository ID is missing'

canonical_organization=$(gh api "orgs/$destination_organization" --jq '.login') ||
    fail "cannot read destination organization $destination_organization"
same_name "$canonical_organization" "$destination_organization" ||
    fail "organization lookup resolved to $canonical_organization, expected $destination_organization"
destination=$canonical_organization/$repository

destination_full=$(gh api "repos/$destination" --jq '.full_name' 2>/dev/null || true)

# Idempotent reruns: an old repository URL redirects to the transferred repository.
# Require identity by immutable repository ID, not merely a matching name.
if same_name "$source_full" "$destination"; then
    [ -n "$destination_full" ] && same_name "$destination_full" "$destination" ||
        fail "source redirects to $destination, but destination is not canonical and accessible"
    destination_id=$(gh api "repos/$destination" --jq '.id') || fail 'cannot read destination repository ID'
    [ "$source_id" = "$destination_id" ] || fail 'source and destination repository IDs differ'
    printf 'status=verified\naction=already_transferred\nrepository_id=%s\nrepository_url=https://github.com/%s\n' "$source_id" "$destination"
    exit 0
fi

same_name "$source_full" "$requested_source" ||
    fail "requested source $requested_source redirects to unrelated $source_full"

if [ -n "$destination_full" ] && same_name "$destination_full" "$destination"; then
    fail "destination already exists: $destination_full"
fi

source_admin=$(gh api "repos/$requested_source" --jq '.permissions.admin') ||
    fail 'cannot determine source administrator permission'
[ "$source_admin" = true ] || fail "authenticated user lacks administrator access to $requested_source"

membership=$(gh api "user/memberships/orgs/$canonical_organization" --jq '.state') ||
    fail "cannot verify membership in $canonical_organization"
[ "$membership" = active ] || fail "membership in $canonical_organization is $membership, not active"

printf 'GitHub repository transfer: requesting %s -> %s (repository ID %s)\n' \
    "$source_full" "$destination" "$source_id" >&2

if transfer_result=$(gh api --method POST "repos/$requested_source/transfer" \
    -f "new_owner=$canonical_organization" --silent 2>&1); then
    :
else
    fail "GitHub rejected transfer: $transfer_result"
fi

attempt=0
while [ "$attempt" -lt 30 ]; do
    destination_full=$(gh api "repos/$destination" --jq '.full_name' 2>/dev/null || true)
    if [ -n "$destination_full" ] && same_name "$destination_full" "$destination"; then
        destination_id=$(gh api "repos/$destination" --jq '.id' 2>/dev/null || true)
        if [ "$destination_id" = "$source_id" ]; then
            printf 'status=verified\naction=transferred\nrepository_id=%s\nrepository_url=https://github.com/%s\n' "$source_id" "$destination"
            exit 0
        fi
        [ -z "$destination_id" ] || fail "destination ID $destination_id differs from original ID $source_id"
    fi
    attempt=$((attempt + 1))
    [ "$attempt" -lt 30 ] && sleep 2
done

source_after=$(gh api "repos/$requested_source" --jq '.full_name' 2>/dev/null || true)
fail "GitHub accepted the request but transfer is unverified; requested=$destination; source_now=${source_after:-unavailable}"
