#!/usr/bin/env grease
# Deterministically emit a complete, standalone Grease transfer program on stdout.
set -eu

fail() {
    printf 'GitHub repository transfer generator: %s\n' "$*" >&2
    exit 2
}

case $# in 4|6) true;; *) fail 'usage: render SOURCE_OWNER REPOSITORY DESTINATION_ORGANIZATION EXPECTED_GITHUB_LOGIN [IMMUTABLE_ID ORIGINAL_UPSTREAM]';; esac
for component in "$1" "$2" "$3" "$4"; do
    case $component in
        ''|[!A-Za-z0-9]*|*[!A-Za-z0-9_.-]*) fail "invalid GitHub name component: $component" ;;
    esac
done

parent=$(dirname "$0")
here=$(CDPATH= cd "$parent" && pwd)
candidate=$here/6.ysh
if test "$#" -eq 6; then
    case $5 in ''|*[!0-9]*) fail 'invalid immutable repository ID';; esac
    case $6 in
        -) true;;
        */*) upstream_owner=${6%%/*}; upstream_repository=${6#*/}
             for component in "$upstream_owner" "$upstream_repository"; do
                 case $component in ''|[!A-Za-z0-9]*|*[!A-Za-z0-9_.-]*) fail 'invalid original upstream';; esac
             done;;
        *) fail 'original upstream must be owner/repository or -';;
    esac
    candidate=$here/8.ysh
fi
candidate_probe=$(mktemp)
try { head -n 1 "$candidate" > "$candidate_probe" 2>/dev/null }
if (_error.code !== 0) {
    rm -f "$candidate_probe"
    fail "cannot read versioned Grease transfer candidate: $candidate"
}
candidate_header=$(cat "$candidate_probe")
rm -f "$candidate_probe"
test "$candidate_header" = '#!/usr/bin/env grease' ||
    fail "invalid versioned Grease transfer candidate header: $candidate"

printf '#!/usr/bin/env grease\n'
printf '# Generated by Kitchen; standalone, with no Kitchen path needed at runtime.\n'
printf '# Move GitHub repository %s/%s -> %s/%s.\n' "$1" "$2" "$3" "$2"
printf 'set -- %s %s %s %s\n' "$1" "$2" "$3" "$4"
if test "$#" -eq 6; then
    printf 'set -- %s %s %s %s %s %s\n' "$1" "$2" "$3" "$4" "$5" "$6"
fi
sed '1d' "$candidate"
