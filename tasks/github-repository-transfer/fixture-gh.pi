"""CLI bridge to disposable FIFO API; cannot write validator observations."""
import json
import sys
import os
from builtins import open
environment ∈ dict[str, str] ← os.environ
argv ∈ list[str] ← sys.argv
root ∈ str ← environment["FP_FIXTURE_IO"]
override ∈ bool ← False
for name in ["GH_TOKEN", "GITHUB_TOKEN", "GH_HOST"]:
    value ∈ object ← environment.get(name)
    if value != None:
        override ← True
with open(root + "/request", "w") as request:
    request.write(json.dumps({"argv": argv[1:], "credential_override": override}))
with open(root + "/response", "r") as stream:
    payload ∈ str ← stream.read(8193)
response ∈ dict[str, object] ← json.loads(payload)
code ∈ int ← int(response["code"])
body ∈ object ← response["body"]
included ∈ bool ← "--include" in argv
if included:
    encoded ∈ str ← json.dumps(body)
    print("HTTP/1.1 " + str(response["http_status"]) + " Fixture\r\nContent-Type: application/json\r\n\r\n" + encoded)
elif code == 0:
    print(json.dumps(body))
else:
    print(str(body), file=sys.stderr)
sys.exit(code)
