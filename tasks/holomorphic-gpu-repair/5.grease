#!/usr/bin/env grease
set -o errexit -o nounset -o pipefail

# This is a Linux build-host task. It never runs compilers on Android devices.
if (int($#) !== 2) { echo 'requires PHASE ABSOLUTE_RUN_CONTEXT' >&2; exit 2 }
var phase = $1
var context = $2
case "$phase" in
    preflight|retained-oracle|independent-checker|producer-field|independent-field|compiler-bootstrap|compiler-api|generated-compiler|generated-binding|recipe-retained|recipe-checker|recipe-producer|recipe-compare|recipe-bootstrap|recipe-api|recipe-generated|recipe-binding) ;;
    *) echo 'unknown holomorphic repair phase' >&2; exit 2 ;;
esac
case "$context" in /*) ;; *) echo 'absolute run context required' >&2; exit 2 ;; esac
test -d "$context"
test "$context" = "$(realpath -- "$context")"
test "$(uname -s)" = Linux
test "$(uname -m)" = x86_64
var recipe = "$(realpath -- "$0")"
var task = "$(dirname -- "$recipe")"
var sources = "$context/sources.tsv"
var tools = "$context/tools.tsv"
var materials = "$context/materials.sha256"
var output = "$context/output"
for material in "$sources" "$tools" "$materials" { test -s "$material" }

# Role tables are data, never source/eval input. Duplicate and malformed rows
# are rejected before selecting a path. Commit and digest checks are separate.
awk -F '\t' 'NF != 3 || $2 !~ /^\// || $3 !~ /^[0-9a-f]+$/ || seen[$1]++ { exit 1 } END { if (NR == 0) exit 1 }' "$sources"
awk -F '\t' 'NF != 3 || $2 !~ /^\// || $3 !~ /^[0-9a-f]+$/ || seen[$1]++ { exit 1 } END { if (NR == 0) exit 1 }' "$tools"
sha256sum -c "$materials"
for required in "$recipe" "$task/Ikefile" "$sources" "$tools" {
    var expected = "$(sha256sum "$required" | cut -d ' ' -f1)"
    grep -Fxq "$expected  $required" "$materials"
}
var holomorphic = "$(awk -F '\t' '$1 == "holomorphic" { print $2 }' "$sources")"
var aici = "$(awk -F '\t' '$1 == "aici" { print $2 }' "$sources")"
var backend = "$(awk -F '\t' '$1 == "shader-backend" { print $2 }' "$sources")"
var idric = "$(awk -F '\t' '$1 == "idric" { print $2 }' "$sources")"
var ithon_source = "$(awk -F '\t' '$1 == "ithon" { print $2 }' "$sources")"
var ike_source = "$(awk -F '\t' '$1 == "ike" { print $2 }' "$sources")"
var grease = "$(awk -F '\t' '$1 == "grease" { print $2 }' "$tools")"
var engine = "$(awk -F '\t' '$1 == "grease-engine" { print $2 }' "$tools")"
var ike = "$(awk -F '\t' '$1 == "ike" { print $2 }' "$tools")"
var ithon = "$(awk -F '\t' '$1 == "ithon" { print $2 }' "$tools")"
var python = "$(awk -F '\t' '$1 == "host-python" { print $2 }' "$tools")"
for checkout in "$holomorphic" "$aici" "$backend" "$idric" "$ithon_source" "$ike_source" {
    test -n "$checkout"
    test -d "$checkout/.git" || test -f "$checkout/.git"
    test "$checkout" = "$(realpath -- "$checkout")"
    var head = "$(awk -F '\t' -v root="$checkout" '$2 == root { print $3 }' "$sources")"
    test "$(printf %s "$head" | wc -c)" = 40
    test "$(git -C "$checkout" rev-parse HEAD)" = "$head"
    git -C "$checkout" diff HEAD --exit-code --quiet
}
for executable in "$grease" "$engine" "$ike" "$ithon" "$python" {
    test -n "$executable"
    test -x "$executable"
    test "$executable" = "$(realpath -- "$executable")"
    var digest = "$(awk -F '\t' -v binary="$executable" '$2 == binary { print $3 }' "$tools" | sort -u)"
    var digest_length = "$(printf %s "$digest" | wc -c)"
    var actual_digest = "$(sha256sum "$executable" | cut -d ' ' -f1)"
    if test "$digest_length" != 64 {
        echo "ambiguous tool digest: $executable" >&2; exit 2
    }
    if test "$actual_digest" != "$digest" {
        echo "tool digest mismatch: $executable" >&2; exit 2
    }
}
test "$engine" = "$(dirname -- "$grease")/ysh"
test "$ithon" = "$ithon_source/ithon"
var checker = "$aici/examples/autogenerated/holomorphic-phase-log/HolomorphicAcceptance.pi"
var compiler = "$(awk -F '\t' '$1 == "ick" { print $2 }' "$tools")"
var linker = "$(awk -F '\t' '$1 == "host-linker" { print $2 }' "$tools")"
var idric_build = "$output/idric-source"
var idric_executable = "$idric_build/_/build/exec/idris2"
var idric_prefix = "$idric_build/_/bootstrap-build"
var chez = "$idric_build/_/.tools/bin/scheme"
var backend_build = "$output/shader-backend"
var generated = "$output/generated"
git -C "$aici" ls-files --error-unmatch -- examples/autogenerated/holomorphic-phase-log/HolomorphicAcceptance.pi > /dev/null
git -C "$holomorphic" ls-files --error-unmatch -- \
    _/oracle/meromorphic_divisor_oracle.py _/oracle/test_meromorphic_divisor_oracle.py \
    _/tests/holo-divisor-sampler.c android/app/src/main/cpp/holomorphic_divisor.h \
    _/tests/test-holo-divisor.c \
    _/shader/runtime_source_binding.h _/shader/test_runtime_source_binding.c > /dev/null
git -C "$holomorphic" ls-files --error-unmatch -- gpu/Example/HolomorphicLive.idr \
    _/shader/bind-generated-fragment.grease _/shader/verify_generated_source_binding.c > /dev/null

if (phase === 'preflight') {
    if test -e "$output" { echo 'refusing existing Holomorphic output directory' >&2; exit 2 }
    mkdir -m 700 "$output"
    cp "$sources" "$tools" "$materials" "$output/"
    printf 'retained_reference\tNOT_RUN\nindependent_checker\tNOT_RUN\nruntime_source_binding_host\tNOT_RUN\nnative_host_field\tNOT_RUN\ngenerated_compiler\tNOT_RUN\napk\tNOT_RUN\nemulator\tNOT_RUN\nphysical_A1_GE8322\tNOT_RUN\nphysical_C67_GE8320\tNOT_RUN\nphysical_TAB_P10_Mali_G57\tNOT_RUN\nsustained_performance\tNOT_RUN\n' > "$output/classifications.tsv"
    printf 'target\tlinux-x86_64-disposable-host\norigin\thttps://github.com/isomorphisms/flexible-pipes/issues/227\n' > "$output/preflight.tsv"
    printf '\033[32mPASS\033[0m exact sources, recipe materials and tool identities\n'
    exit 0
}
test -s "$output/preflight.tsv"
cmp "$sources" "$output/sources.tsv"
cmp "$tools" "$output/tools.tsv"
cmp "$materials" "$output/materials.sha256"

if (phase === 'recipe-retained') {
    test -s "$holomorphic/_/oracle/test_meromorphic_divisor_oracle.py"
    cd -- "$holomorphic"
    # Retained, previously reviewed binary64 oracle; this is not GPU execution.
    "$python" -m unittest discover -s _/oracle -p 'test_*.py' > "$output/retained-reference.log" 2>&1
    test -s "$output/retained-reference.log"
    grep -Eq '^Ran [1-9][0-9]* tests?' "$output/retained-reference.log"
    grep -Fxq OK "$output/retained-reference.log"
    exit 0
}
if (phase === 'recipe-checker') {
    test -s "$checker"
    test ! -e "$output/checker"
    test ! -e "$output/corpus"
    env ITHON_PYTHON="$python" "$ithon" "$checker" selftest "$output/checker" > "$output/checker.log" 2>&1
    env ITHON_PYTHON="$python" "$ithon" "$checker" corpus "$output/corpus" > "$output/corpus.log" 2>&1
    test -s "$output/checker.log"
    grep -Fxq 'PASS independent checker fixtures; producer/GPU/emulator/physical acceptance NOT_RUN' "$output/checker.log"
    test -s "$output/corpus/cases.tsv"
    grep -Fxq 'PASS corpus cases=31' "$output/corpus.log"
    exit 0
}
if (phase === 'recipe-producer') {
    var compiler = "$(awk -F '\t' '$1 == "ick" { print $2 }' "$tools")"
    if test -z "$compiler" || ! test -x "$compiler" {
        printf 'BLOCKED: exact ICK host C compiler executable is unavailable; no substitute compiler is permitted\n' >&2
        printf 'producer-field\tmissing-exact-ICK-host-compiler\n' > "$output/blocker.tsv"
        exit 3
    }
    var compiler_digest = "$(awk -F '\t' '$1 == "ick" { print $3 }' "$tools")"
    test "$(sha256sum "$compiler" | cut -d ' ' -f1)" = "$compiler_digest"
    var linker = "$(awk -F '\t' '$1 == "host-linker" { print $2 }' "$tools")"
    test -x "$linker"
    var linker_digest = "$(awk -F '\t' '$1 == "host-linker" { print $3 }' "$tools")"
    test "$(sha256sum "$linker" | cut -d ' ' -f1)" = "$linker_digest"
    test -s "$output/corpus/cases.tsv"
    test -s "$holomorphic/_/tests/holo-divisor-sampler.c"
    test ! -e "$output/holo-divisor-sampler.o"
    test ! -e "$output/holo-divisor-sampler"
    test -s "$holomorphic/_/shader/test_runtime_source_binding.c"
    "$compiler" -O2 -std=c11 -Wall -Wextra -Werror -pedantic -fPIC -c \
        "$holomorphic/_/shader/test_runtime_source_binding.c" -o "$output/runtime-source-binding.o"
    "$linker" "$output/runtime-source-binding.o" -o "$output/runtime-source-binding"
    "$output/runtime-source-binding" > "$output/runtime-source-binding.log" 2>&1
    test -s "$output/runtime-source-binding.log"
    grep -Fxq 'PASS swapped-source-unchanged-sidecar-rejected' "$output/runtime-source-binding.log"
    grep -Fxq 'PASS missing-provenance-rejected' "$output/runtime-source-binding.log"
    "$compiler" -O2 -std=c11 -Wall -Wextra -Werror -fPIC -c \
        "$holomorphic/_/tests/test-holo-divisor.c" -o "$output/test-holo-divisor.o"
    "$linker" "$output/test-holo-divisor.o" -lm -o "$output/test-holo-divisor"
    "$output/test-holo-divisor" > "$output/test-holo-divisor.log" 2>&1
    grep -Fxq 'PASS host exact divisor, multiplicities, displaced pairs, moving poles, input rejection' "$output/test-holo-divisor.log"
    "$compiler" -O2 -std=c11 -Wall -Wextra -Werror -fPIC -c \
        "$holomorphic/_/tests/holo-divisor-sampler.c" -o "$output/holo-divisor-sampler.o"
    # Explicit host-driver boundary links the ICK object with libc/libm.
    "$linker" "$output/holo-divisor-sampler.o" -lm -o "$output/holo-divisor-sampler"
    "$output/holo-divisor-sampler" "$output/corpus/cases.tsv" > "$output/native-field.tsv"
    test -s "$output/native-field.tsv"
    sha256sum "$compiler" "$linker" "$output/runtime-source-binding.o" \
        "$output/runtime-source-binding" "$output/runtime-source-binding.log" "$output/holo-divisor-sampler.o" \
        "$output/test-holo-divisor.o" "$output/test-holo-divisor" "$output/test-holo-divisor.log" \
        "$output/holo-divisor-sampler" "$output/native-field.tsv" > "$output/native-field.sha256"
    exit 0
}
if (phase === 'recipe-compare') {
    test -s "$output/native-field.tsv"
    env ITHON_PYTHON="$python" "$ithon" "$checker" compare "$output/corpus/cases.tsv" "$output/native-field.tsv" > "$output/native-acceptance.log" 2>&1
    test -s "$output/native-acceptance.log"
    exit 0
}
if (phase === 'recipe-bootstrap') {
    test -x "$compiler"
    var compiler_digest = "$(awk -F '\t' '$1 == "ick" { print $3 }' "$tools")"
    test "$(sha256sum "$compiler" | cut -d ' ' -f1)" = "$compiler_digest"
    test ! -e "$idric_build"
    mkdir "$idric_build"
    git -C "$idric" archive HEAD | tar -x -C "$idric_build"
    test -x "$idric_build/edric"
    cd -- "$idric_build"
    # Owner-provided bootstrap preserves its pinned Chez/toolchain contract.
    # Native compiler support is built through the independently qualified ICK.
    env CC="$compiler" CFLAGS='-fno-link-libatomic -static-libgcc' \
        ./edric bootstrap > "$output/idric-bootstrap.log" 2>&1
    test -x "$idric_executable"
    test -x "$chez"
    sha256sum "$compiler" "$idric_executable" "$chez" > "$output/idric-bootstrap.sha256"
    rg --files --hidden --no-ignore -0 "$idric_build/_/build/exec" | sort -z | xargs -0 sha256sum > "$output/idric-payload.sha256"
    test -s "$output/idric-payload.sha256"
    exit 0
}
if (phase === 'recipe-api') {
    test -s "$output/idric-bootstrap.sha256"
    sha256sum -c "$output/idric-bootstrap.sha256"
    sha256sum -c "$output/idric-payload.sha256"
    cd -- "$idric_build/_"
    env IDRIS2_PREFIX="$idric_prefix" CHEZ="$chez" "$idric_executable" \
        --install idris2api.ipkg > "$output/idric-api.log" 2>&1
    env IDRIS2_PREFIX="$idric_prefix" CHEZ="$chez" "$idric_executable" \
        --version > "$output/idric-version.txt"
    test -s "$output/idric-api.log"
    sha256sum -c "$output/idric-payload.sha256"
    test -s "$output/idric-version.txt"
    exit 0
}
if (phase === 'recipe-generated') {
    test -s "$output/idric-api.log"
    test ! -e "$backend_build"
    test ! -e "$generated"
    mkdir "$backend_build" "$generated"
    git -C "$backend" archive HEAD | tar -x -C "$backend_build"
    cp "$holomorphic/gpu/Example/HolomorphicLive.idr" "$backend_build/src/Example/HolomorphicLive.idr"
    cd -- "$backend_build"
    env IDRIS2_PREFIX="$idric_prefix" CHEZ="$chez" "$idric_executable" \
        --build backend.ipkg > "$output/shader-backend-build.log" 2>&1
    test -x "$backend_build/build/exec/idris2-glsles"
    rg --files --hidden --no-ignore -0 "$backend_build/build/exec" | sort -z | xargs -0 sha256sum > "$output/backend-payload.sha256"
    test -s "$output/backend-payload.sha256"
    env IDRIS2_PREFIX="$idric_prefix" CHEZ="$chez" \
        "$backend_build/build/exec/idris2-glsles" --cg glsles \
        --source-dir "$backend_build/src" --output-dir "$generated" \
        "$backend_build/src/Example/HolomorphicLive.idr" -o continuation \
        > "$output/holomorphic-generation.log" 2>&1
    test -s "$generated/continuation.frag"
    var validator = "$(awk -F '\t' '$1 == "shader-validator" { print $2 }' "$tools")"
    var validator_digest = "$(awk -F '\t' '$1 == "shader-validator" { print $3 }' "$tools")"
    test -x "$validator"
    test "$(sha256sum "$validator" | cut -d ' ' -f1)" = "$validator_digest"
    "$validator" -S frag "$generated/continuation.frag" > "$output/glsl-validation.log" 2>&1
    for declaration in \
        'uniform vec2 u_holomorphic_coefficients[5];' \
        'uniform vec2 u_zero_positions[32];' 'uniform vec2 u_pole_positions[32];' \
        'uniform vec2 u_remote_pole_positions[24];' 'uniform int u_divisor_count;' \
        'uniform vec3 u_divisor_factors[96];' 'uniform int u_numeric_output;' \
        'uniform vec2 u_numeric_point;' {
        grep -Fq "$declaration" "$generated/continuation.frag"
    }
    var backend_head = "$(git -C "$backend" rev-parse HEAD)"
    var application_head = "$(git -C "$holomorphic" rev-parse HEAD)"
    var fragment_digest = "$(sha256sum "$generated/continuation.frag" | cut -d ' ' -f1)"
    printf 'compiler=idris2-glsles\nbackend_repo=fuego-ironworks/idris-shader-backend\nbackend_commit=%s\napplication_repo=isomorphismes/holomorphic\napplication_commit=%s\nfragment_sha256=%s\n' \
        "$backend_head" "$application_head" "$fragment_digest" > "$generated/continuation.provenance"
    sha256sum "$holomorphic/gpu/Example/HolomorphicLive.idr" \
        "$backend_build/build/exec/idris2-glsles" "$generated/continuation.frag" \
        "$generated/continuation.provenance" > "$output/generated-compiler.sha256"
    exit 0
}
if (phase === 'recipe-binding') {
    test -s "$output/generated-compiler.sha256"
    sha256sum -c "$output/generated-compiler.sha256"
    mkdir "$generated/binding"
    "$grease" "$holomorphic/_/shader/bind-generated-fragment.grease" \
        "$generated/continuation.frag" "$generated/continuation.provenance" \
        "$generated/binding/holomorphic_shader_binding.h" > "$output/generated-header.log"
    "$compiler" -O2 -std=c11 -Wall -Wextra -Werror -pedantic -fPIC \
        -I "$generated/binding" -c "$holomorphic/_/shader/verify_generated_source_binding.c" \
        -o "$output/verify-generated-binding.o"
    "$linker" "$output/verify-generated-binding.o" -o "$output/verify-generated-binding"
    "$output/verify-generated-binding" "$generated/continuation.frag" \
        "$generated/continuation.provenance" > "$output/generated-binding.log"
    grep -Fq 'PASS actual generated source binding host check' "$output/generated-binding.log"
    cp "$generated/continuation.frag" "$generated/changed.frag"
    printf ' ' >> "$generated/changed.frag"
    try { "$output/verify-generated-binding" "$generated/changed.frag" \
        "$generated/continuation.provenance" > "$output/generated-binding-mutant.log" 2>&1 }
    if (_error.code !== 1) { echo 'changed generated source was not rejected' >&2; exit 1 }
    grep -Fq 'FAIL actual generated source binding: source-length-mismatch' "$output/generated-binding-mutant.log"
    sha256sum "$output/verify-generated-binding.o" "$output/verify-generated-binding" \
        "$generated/binding/holomorphic_shader_binding.h" "$output/generated-binding.log" \
        "$output/generated-binding-mutant.log" > "$output/generated-binding.sha256"
    exit 0
}

var target = phase
test ! -e "$output/$target.ike.tsv"
var ikefile_digest = "$(sha256sum "$task/Ikefile" | cut -d ' ' -f1)"
cd -- "$task"
env HOLO_GREASE="$grease" HOLO_KITCHEN_RECIPE="$recipe" HOLO_CONTEXT="$context" \
    IKE_RECIPE_RUNNER="$grease" IKE_IKEFILE_IDENTITY="sha256:$ikefile_digest" \
    IKE_RECEIPT="$output/$target.ike.tsv" "$ike" "$target"
test -s "$output/$target.ike.tsv"
grep -Fxq 'recipe_runner_mode	external-source-file' "$output/$target.ike.tsv"
grep -Fxq 'final_result	PASS' "$output/$target.ike.tsv"
var category = ''
case "$target" in
    retained-oracle) category=retained_reference ;;
    independent-checker) category=independent_checker ;;
    producer-field) category=runtime_source_binding_host ;;
    independent-field) category=native_host_field ;;
    generated-binding) category=generated_compiler ;;
esac
if test -n "$category" {
    awk -F '\t' -v key="$category" 'BEGIN { OFS="\t" } $1 == key { $2="PASS" } { print }' \
        "$output/classifications.tsv" > "$output/classifications.next.tsv"
    mv "$output/classifications.next.tsv" "$output/classifications.tsv"
}
printf '\033[32mPASS\033[0m %s through digest-bound Grease/Ike\n' "$target"
