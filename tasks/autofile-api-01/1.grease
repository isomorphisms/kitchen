#!/usr/bin/env grease
set -o errexit -o nounset -o pipefail
if (int($#) !== 11) { echo 'requires PRODUCER HEAD AICI HEAD KITCHEN HEAD IKE HEAD ICK GREASE EVIDENCE' >&2; exit 2 }
var producer = $1
var producer_head = $2
var aici_root = $3
var aici_head = $4
var kitchen_root = $5
var kitchen_head = $6
var ike_root = $7
var ike_head = $8
var compiler = $9
var grease = ${10}
var evidence = ${11}
test "$(uname -s)" = Linux
test "$(uname -m)" = x86_64
test "$producer" = "$(realpath -- "$producer")"
test "$aici_root" = "$(realpath -- "$aici_root")"
test "$kitchen_root" = "$(realpath -- "$kitchen_root")"
test "$ike_root" = "$(realpath -- "$ike_root")"
test "$evidence" = "$(realpath -- "$evidence")"
test "$(stat -c %a -- "$evidence")" = 700
test ! -e "$evidence/ike.tsv"
test "$(git -C "$producer" rev-parse HEAD)" = "$producer_head"
test "$(git -C "$aici_root" rev-parse HEAD)" = "$aici_head"
test "$(git -C "$kitchen_root" rev-parse HEAD)" = "$kitchen_head"
test "$(git -C "$ike_root" rev-parse HEAD)" = "$ike_head"
git -C "$producer" diff --quiet
git -C "$aici_root" diff --quiet
git -C "$kitchen_root" diff --quiet
git -C "$ike_root" diff --quiet
test -x "$compiler"
test -x "$grease"
test -x "$ike_root/ike"
test "$(sha256sum "$grease" | cut -d ' ' -f 1)" = 7e31cd05b7a9d8fb2a4a9e003a7f3fcb0159138506d17f0fb28da8cbe22aa85c
var task = "$kitchen_root/tasks/autofile-api-01/1"
var identity = "$(sha256sum "$task/Ikefile" | cut -d ' ' -f 1)"
setglobal ENV.AUTOFILE_PRODUCER_ROOT = producer
setglobal ENV.AUTOFILE_AICI_ROOT = aici_root
setglobal ENV.AUTOFILE_ICK = compiler
setglobal ENV.AUTOFILE_EVIDENCE = evidence
cd -- "$task"
env IKE_RECIPE_RUNNER="$grease" IKE_RECEIPT="$evidence/ike.tsv" IKE_IKEFILE_IDENTITY="sha256:$identity" "$ike_root/ike" accept
sha256sum "$producer/src/autofile_api.c" "$producer/src/af_json.c" \
  "$producer/build/test_autofile_api" "$aici_root/autofile-api/check.c" \
  "$aici_root/autofile-api/build/check" "$evidence/toolchain-check" \
  "$compiler" "$grease" "$ike_root/ike" "$task/Ikefile"
printf 'PASS\tpinned-autofile-api-Kitchen-Ike-procedure\nlive_ChatGPT_account\tNOT_RUN\nconversation_move\tNOT_RUN\nproduction_controller\tNOT_ACCEPTED\n'

