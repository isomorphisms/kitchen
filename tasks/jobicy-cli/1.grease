#!/usr/bin/env grease
# Build and installed tests are distinct operations, with no acquisition here.
if (int($#) < 2) { echo 'requires MODE ABSOLUTE_CLI_ROOT [ABSOLUTE_PREFIX]' >&2; exit 2 }
var mode = $1
var repo = $2
if (not repo.startsWith('/')) { echo 'CLI root must be absolute' >&2; exit 2 }
var compiler = get(ENV, 'IDRIC') or ''
var icu = get(ENV, 'ICU_ROOT') or ''
var ick = get(ENV, 'ICK') or ''
proc pin (component, root) {
  var expected = "$(awk -F '\t' -v component="$component" '$1 == component {print $3}' "$repo/checkpoints/jobicy/source-pins.tsv")"
  test -n "$expected"
  test "$(git -C "$root" rev-parse HEAD)" = "$expected"
}
if (mode === 'preflight' or mode === 'build') {
  test "$(uname -s)" = Linux
  test "$(uname -m)" = x86_64
  test -x "$compiler"
  test -x "$ick"
  pin Idric $[ENV.IDRIC_ROOT]
  pin Idric-JSON $[ENV.IDRIC_JSON_ROOT]
  pin Idric-Net $[ENV.IDRIC_NET_ROOT]
  pin ICU "$icu"
  pin ICK $[ENV.ICK_SOURCE_ROOT]
  "$compiler" --version
  "$ick" --version
  if (mode === 'preflight') { exit 0 }
  cd -- "$repo"
  mkdir -p build/qualification
  # This C slice uses no compiler atomic builtins. GCC 17's automatic
  # libatomic link is disabled explicitly; its optional runtime is not built.
  var flags = :| -fno-link-libatomic |
  var driver = get(ENV, 'ICK_DRIVER_DIR') or ''
  var support = get(ENV, 'HOST_LIBGCC_DIR') or ''
  if (driver !== '') { setvar flags = flags ++ ["-B$driver/"] }
  if (support !== '') { setvar flags = flags ++ ["-B$support/", '-static-libgcc'] }
  "$ick" @flags checkpoints/jobicy/ick-qualification.c -o build/qualification/ick-check
  build/qualification/ick-check
  "$compiler" --build jobicy.ipkg
  "$compiler" --build jobicy-fixture-server.ipkg
  "$ick" @flags -O2 -std=c11 -Wall -Wextra -Werror -fPIC -shared "$icu/native/transport.c" -o build/exec/jobicy_app/libicu_transport.so -lssl -lcrypto
  sha256sum examples/autogenerated/jobicy-cli/Jobicy.idric examples/autogenerated/jobicy-cli/Jobicy/Protocol.idric examples/autogenerated/jobicy-cli/Jobicy/Run.idric > build/exec/jobicy_app/source.sha256
  build/exec/jobicy version
} elif (mode === 'install') {
  if (int($#) !== 3) { echo 'install requires an absolute prefix' >&2; exit 2 }
  var prefix = $3
  if (not prefix.startsWith('/')) { echo 'install prefix must be absolute' >&2; exit 2 }
  test -s "$repo/build/exec/jobicy_app/libicu_transport.so"
  mkdir -p "$prefix/bin/jobicy_app"
  cp -R "$repo/build/exec/jobicy_app/." "$prefix/bin/jobicy_app/"
  install -m 0755 "$repo/build/exec/jobicy" "$prefix/bin/jobicy"
  var temporary = "$(mktemp -d)"
  cd -- "$temporary"
  "$prefix/bin/jobicy" version
} elif (mode === 'test') {
  test -x $[ENV.JOBICY_PROGRAM]
  var temporary = "$(mktemp -d)"
  cd -- "$repo"
  sha256sum --check "$[ENV.JOBICY_PROGRAM]_app/source.sha256"
  cd -- "$temporary"
  $[ENV.GREASE] "$repo/checkpoints/jobicy/check.grease"
} else {
  echo 'mode must be preflight, build, install, or test' >&2
  exit 2
}
