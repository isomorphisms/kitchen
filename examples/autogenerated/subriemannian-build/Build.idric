module Build

import Data.List
import Data.Text
import System
import System.File
import System.Directory

covering
capture : List Text → IO Text
capture command = do
  opened ← Escaped.popen command Read
  case opened of
    Left error ⇒ die ("cannot launch build command: " ++ show error)
    Right stream ⇒ do
      output ← fRead stream
      status ← pclose stream
      case output of
        Left error ⇒ die ("cannot read build command: " ++ show error)
        Right contents ⇒ if status ≟ 0 then pure contents
          else die ("build command failed: " ++ show command ++ "\n" ++ contents)

write_checked : Text → Text → IO ()
write_checked path contents = do
  written ← writeFile path contents
  case written of Left error ⇒ die ("cannot write receipt: " ++ show error); Right () ⇒ pure ()

absolute : Text → Bool
absolute path = isPrefixOf "/" path && not (isInfixOf "\n" path) && not (isInfixOf "\t" path)

covering
source_head : Text → IO Text
source_head root = do
  dirty ← capture ["git", "-C", root, "status", "--porcelain", "--untracked-files=no"]
  if trim dirty ≟ "" then pure () else die ("tracked source is dirty: " ++ root)
  trim <$> capture ["git", "-C", root, "rev-parse", "HEAD"]

covering
compile_program : Text → Text → Text → Text → Text → IO Text
compile_program compiler source_directory build_root source output_name = do
  changed ← changeDir source_directory
  if changed then pure () else die ("cannot enter verified source directory: " ++ source_directory)
  capture [compiler,"--cg","chez","--build-dir",build_root ++ "/ttc/" ++ output_name,
    "--output-dir",build_root,"-o",output_name,source]

covering
run : List Text → IO ()
run [project, compiler_root, aici, kitchen, build_root] = do
  if all absolute [project, compiler_root, aici, kitchen, build_root] then pure () else die "absolute roots required"
  let compiler = compiler_root ++ "/_/build/exec/idris2"
      scheme = compiler_root ++ "/_/.tools/bin/scheme"
      source_directory = project ++ "/examples/autogenerated/subriemannian"
  available ← traverse exists [compiler,scheme,source_directory ++ "/Main.idric",
    aici ++ "/examples/autogenerated/subriemannian/Accept.idric"]
  if all id available then pure () else die "compiler/runtime or declared source is missing"
  existing ← exists build_root
  if existing then die "refusing existing artifact directory" else pure ()
  project_head ← source_head project
  compiler_head ← source_head compiler_root
  aici_head ← source_head aici
  kitchen_head ← source_head kitchen
  created ← capture ["mkdir","-p",build_root]
  ignore $ setEnv "CHEZ" scheme True
  ignore $ setEnv "IDRIS2_PREFIX" (compiler_root ++ "/_/bootstrap-build") True
  ignore $ setEnv "IDRIS2_PATH" (compiler_root ++ "/_/libs/prelude/build/ttc:" ++ compiler_root ++ "/_/libs/base/build/ttc") True
  first ← compile_program compiler source_directory build_root "Main.idric" "subriemannian"
  second ← compile_program compiler source_directory build_root "Tests.idric" "mathematical-tests"
  third ← compile_program compiler source_directory build_root "Figure.idric" "figure"
  fourth ← compile_program compiler (aici ++ "/examples/autogenerated/subriemannian") build_root "Accept.idric" "aici-accept"
  write_checked (build_root ++ "/compile.stdout.txt") (first ++ second ++ third ++ fourth)
  tests ← capture [build_root ++ "/mathematical-tests"]
  write_checked (build_root ++ "/tests.stdout.txt") tests
  figure ← capture [build_root ++ "/figure",project ++ "/figures/loop-template.html",
    build_root ++ "/heisenberg-loop.html",build_root ++ "/heisenberg-loop.tsv"]
  ignore $ capture ["cmp",project ++ "/figures/heisenberg-loop.html",build_root ++ "/heisenberg-loop.html"]
  ignore $ capture ["cmp",project ++ "/figures/heisenberg-loop.tsv",build_root ++ "/heisenberg-loop.tsv"]
  write_checked (build_root ++ "/figure.stdout.txt") figure
  producer_hash ← capture ["sha256sum",build_root ++ "/subriemannian_app/subriemannian.so"]
  write_checked (build_root ++ "/producer.sha256") producer_hash
  artifacts ← capture (["sha256sum", compiler, scheme, build_root ++ "/subriemannian_app/subriemannian.so",
    build_root ++ "/mathematical-tests_app/mathematical-tests.so",build_root ++ "/figure_app/figure.so",
    build_root ++ "/aici-accept_app/aici-accept.so",build_root ++ "/subriemannian_app/libidris2_support.so",
    project ++ "/examples/autogenerated/subriemannian/Objects.idric",
    project ++ "/examples/autogenerated/subriemannian/Integration.idric",
    project ++ "/examples/autogenerated/subriemannian/Main.idric",
    project ++ "/examples/autogenerated/subriemannian/Tests.idric",
    project ++ "/examples/autogenerated/subriemannian/Figure.idric",
    aici ++ "/examples/autogenerated/subriemannian/Accept.idric",
    build_root ++ "/heisenberg-loop.html",build_root ++ "/heisenberg-loop.tsv"])
  write_checked (build_root ++ "/identities.sha256") artifacts
  write_checked (build_root ++ "/producer.receipt.tsv")
    ("schema\tsubriemannian-build-v1\nproject_head\t" ++ project_head ++
     "\ncompiler_head\t" ++ compiler_head ++ "\naici_head\t" ++ aici_head ++
     "\nkitchen_head\t" ++ kitchen_head ++ "\nbackend\tIdriç/Chez Linux x86-64\n" ++
     "tests\tPASS\nfigure_reproduction\tPASS\nproducer\tPASS\naici_acceptance\tSEPARATE_STAGE\n")
  putStrLn "PASS\tKitchen compiled programs, mathematical tests, and figure reproduction"
run _ = die "usage: build PROJECT_ROOT IDRIC_ROOT AICI_ROOT KITCHEN_ROOT NEW_ARTIFACT_ROOT"

covering
main : IO ()
main = do
  arguments ← getArgs
  run (drop 1 arguments)
