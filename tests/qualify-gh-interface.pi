"""Exercise installed GitHub CLI against disposable loopback HTTP responses."""
import os
import sys
import json
import hashlib
import subprocess
import threading
from pathlib import Path
from http.server import BaseHTTPRequestHandler, HTTPServer
from builtins import dict, list, ValueError
argv ∈ list[str] ← sys.argv
observations ∈ list[dict[str, object]] ← []
class Handler(BaseHTTPRequestHandler):
    def do_GET(self ∈ object) → None:
        path ∈ str ← self.path
        status ∈ int ← 404 if path == "/missing" else 403 if path == "/denied" else 200
        observations.append({"path": path, "status": status})
        payload ∈ bytes ← json.dumps({"message": "fixture", "id": 123}).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)
server ∈ object ← HTTPServer(("127.0.0.1", 0), Handler)
thread ∈ object ← threading.Thread(target=server.serve_forever, daemon=True)
thread.start()
address ∈ tuple[str, int] ← server.server_address
environment ∈ dict[str, str] ← {"PATH": "/usr/bin:/bin", "HOME": "/nonexistent", "GH_CONFIG_DIR": "/nonexistent", "GH_TOKEN": "disposable-not-a-live-token", "GH_NO_UPDATE_NOTIFIER": "1", "GH_PROMPT_DISABLED": "1"}
checks ∈ list[dict[str, object]] ← []
try:
    for endpoint in ["missing", "denied", "present"]:
        process ∈ object ← subprocess.run(["/usr/bin/gh", "api", "--include", "http://127.0.0.1:" + str(address[1]) + "/" + endpoint], env=environment, capture_output=True, timeout=10)
        data ∈ bytes ← process.stdout
        code ∈ int ← process.returncode
        expected ∈ int ← 0 if endpoint == "present" else 1
        status ∈ int ← 404 if endpoint == "missing" else 403 if endpoint == "denied" else 200
        detail ∈ str ← data.decode(errors="replace")
        if code != expected or not data.startswith(("HTTP/1.0 " + str(status) + " ").encode()):
            raise ValueError("GH_HTTP_INTERFACE_MISMATCH: " + endpoint + ": " + str(code) + ": " + detail)
        checks.append({"endpoint": endpoint, "exit_code": code, "stdout": data.decode(), "stderr": process.stderr.decode()})
    environment.pop("GH_TOKEN")
    process ← subprocess.run(["/usr/bin/gh", "api", "user"], env=environment, capture_output=True, timeout=10)
    code ← process.returncode
    if code != 4:
        raise ValueError("GH_AUTHENTICATION_EXIT_INTERFACE_MISMATCH")
    checks.append({"case": "no-authentication", "exit_code": code})
finally:
    server.shutdown()
    server.server_close()
result ∈ dict[str, object] ← {"status": "PASS", "checks": checks, "observations": observations, "executable_sha256": hashlib.sha256(Path("/usr/bin/gh").read_bytes()).hexdigest(), "excluded_claims": ["live-credentials", "live-transfer", "deployment"]}
Path(argv[1]).write_text(json.dumps(result, sort_keys=True))
print("GitHub CLI HTTP/authentication interfaces qualified")
