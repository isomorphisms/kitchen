"""Generate a real, bounded PNG fixture; no device or visual acceptance."""
from pathlib import Path
from builtins import list
import struct
import zlib
import sys

def chunk(kind ∈ bytes, data ∈ bytes) → bytes:
    length ∈ int ← len(data)
    crc ∈ int ← zlib.crc32(kind + data)
    prefix ∈ bytes ← struct.pack(">I", length)
    suffix ∈ bytes ← struct.pack(">I", crc)
    answer ∈ bytes ← prefix + kind + data + suffix
    return answer

header ∈ bytes ← struct.pack(">IIBBBBB", 1, 1, 8, 6, 0, 0, 0)
pixel ∈ bytes ← zlib.compress(b"\x00\xff\xff\xff\xff")
frame ∈ bytes ← b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", header) + chunk(b"IDAT", pixel) + chunk(b"IEND", b"")
array ∈ str ← ""
values ∈ list[int] ← list(frame)
for value in values:
    array ← array + str(value) + ","
argv ∈ list[str] ← sys.argv
Path(argv[1]).write_text("/* Generated by frame-fixture.pi: structural 1x1 RGBA fixture. */\nstatic const unsigned char frame_png[] = {" + array + "};\n")
