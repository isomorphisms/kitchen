"""Local artifact diagnostic; it does not qualify FP worker isolation or deploy."""
import sys
import os
import json
import subprocess
import signal
import hashlib
from pathlib import Path
from builtins import dict, list, open, ValueError, ProcessLookupError

argv ∈ list[str] ← sys.argv
workspace ∈ str ← argv[1]
output ∈ str ← argv[2]
launcher ∈ str ← argv[3]
grease_source ∈ str ← argv[4]
Path(output).mkdir(mode=493, parents=True, exist_ok=False)
ithon ∈ list[str] ← ["/usr/bin/python3", workspace + "/ithon/ithon_host.py"]
task ∈ str ← workspace + "/kitchen/tasks/github-repository-transfer"
environment ∈ dict[str, str] ← {"PATH": output + "/bin:/usr/bin:/bin", "PYTHONPATH": grease_source + ":" + grease_source + "/vendor", "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8"}
control_environment ∈ dict[str, str] ← {"PATH": "/usr/bin:/bin", "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8"}
Path(output + "/bin").mkdir()
bridge ∈ str ← "#!" + launcher + "\nexec /usr/bin/env -u PYTHONHOME -u PYTHONPATH /usr/bin/python3 " + workspace + "/ithon/ithon_host.py " + task + '/fixture-gh.pi "$@"\n'
Path(output + "/bin/gh").write_text(bridge)
os.chmod(output + "/bin/gh", 365)
inputs ∈ dict[str, object] ← {"source_owner": "source", "repository": "sample", "destination_owner": "destination", "expected_login": "login", "expected_repository_id": 123, "target_context": "linux-x86_64-grease-v1"}
fields ∈ list[str] ← ["source_owner", "repository", "destination_owner", "expected_login", "expected_repository_id", "target_context"]
if len(argv) > 5:
    inputs ← json.loads(Path(argv[5]).read_bytes())
if set(inputs) != set(fields):
    raise ValueError("INPUT_FIELDS")
filename ∈ str ← "transfer-" + str(inputs["repository"]) + "-from-" + str(inputs["source_owner"]) + "-to-" + str(inputs["destination_owner"]) + ".sh"
artifacts ∈ list[bytes] ← []
for index in range(2):
    work ∈ str ← output + "/generation space '" + str(index)
    Path(work).mkdir()
    generation ∈ list[str] ← [launcher, task + "/generate-transfer-github-repository-script.sh"]
    for field in fields:
        generation.append(str(inputs[field]))
    child ∈ object ← subprocess.run(generation, cwd=work, env=environment, capture_output=True, timeout=10)
    Path(work + "/stdout.bin").write_bytes(child.stdout)
    Path(work + "/stderr.bin").write_bytes(child.stderr)
    code ∈ int ← child.returncode
    if code != 0:
        raise ValueError("generation failed")
    artifacts.append(Path(work + "/" + filename).read_bytes())
if artifacts[0] != artifacts[1]:
    raise ValueError("generation was not deterministic")
artifact ∈ str ← output + "/" + filename
Path(artifact).write_bytes(artifacts[0])
digest ∈ str ← hashlib.sha256(artifacts[0]).hexdigest()
decisions ∈ list[dict[str, object]] ← []
for mode in ["personal", "organization", "accepted-unverified", "accepted-still-pending", "visibility", "post-failure", "wrong-id", "collision", "authentication", "capability", "network", "destination-authentication", "destination-api"]:
    base ∈ str ← output + "/" + mode
    Path(base).mkdir()
    executed_artifact ∈ str ← base + "/" + filename
    Path(executed_artifact).write_bytes(artifacts[0])
    os.chmod(executed_artifact, 292)
    os.mkfifo(base + "/request")
    os.mkfifo(base + "/response")
    specification ∈ str ← base + "/fixture.json"
    Path(specification).write_text(json.dumps({"inputs": inputs, "mode": mode, "artifact_sha256": digest}))
    server_command ∈ list[str] ← list(ithon)
    server_command.extend([task + "/fixture-api.pi", base, specification])
    with open(base + "/server.stderr.bin", "xb") as error:
        server ∈ object ← subprocess.Popen(server_command, env=control_environment, stderr=error, start_new_session=True)
        codes ∈ list[int] ← []
        try:
            executions ∈ int ← 2 if mode == "personal" or mode == "organization" or mode == "accepted-unverified" or mode == "accepted-still-pending" else 1
            for index in range(executions):
                work ← base + "/unrelated cwd '" + str(index)
                home ∈ str ← base + '/fresh home "' + str(index)
                Path(work).mkdir()
                Path(home).mkdir()
                child_environment ∈ dict[str, str] ← dict(environment)
                child_environment["HOME"] ← home
                child_environment["FP_FIXTURE_IO"] ← base
                child_environment["GH_TOKEN"] ← "disposable-fixture-token"
                child_environment["GITHUB_TOKEN"] ← "disposable-fixture-token"
                child_environment["GH_HOST"] ← "invalid.fixture"
                child ← subprocess.run([launcher, workspace + "/kitchen/tests/transfer-parent.grease", launcher, executed_artifact], cwd=work, env=child_environment, capture_output=True, timeout=10)
                Path(base + "/stdout-" + str(index) + ".bin").write_bytes(child.stdout)
                Path(base + "/stderr-" + str(index) + ".bin").write_bytes(child.stderr)
                parent_output ∈ bytes ← child.stdout
                if not parent_output.endswith(b"PARENT_SURVIVED\n"):
                    raise ValueError("parent shell did not survive")
                code ← child.returncode
                codes.append(code)
            if len(codes) == 1:
                codes.append(-125)
            execution ∈ str ← base + "/execution.json"
            Path(execution).write_text(json.dumps({"first_exit": codes[0], "second_exit": codes[1]}))
            validator ∈ list[str] ← list(ithon)
            validator.extend([workspace + "/ai-ci/validators/kitchen-transfer-script.pi", specification, base + "/observations.json", execution, artifact, base + "/decision.json"])
            child ← subprocess.run(validator, env=control_environment, capture_output=True, timeout=10)
            Path(base + "/validator.stderr.bin").write_bytes(child.stderr)
            code ← child.returncode
            if code != 0:
                raise ValueError("independent fixture failed: " + mode)
            decision ∈ dict[str, object] ← json.loads(Path(base + "/decision.json").read_bytes())
            decisions.append(decision)
        finally:
            try:
                os.killpg(server.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            server.wait()
Path(output + "/result.json").write_text(json.dumps({"status": "PASS", "scope": "local-artifact-diagnostic", "excluded_claims": ["worker-isolation", "trusted-execution", "deployment", "live-transfer"], "inputs": inputs, "artifact_sha256": digest, "generator_sha256": hashlib.sha256(Path(task + "/generate-transfer-github-repository-script.sh").read_bytes()).hexdigest(), "candidate_sha256": hashlib.sha256(Path(task + "/9.sh").read_bytes()).hexdigest(), "launcher_sha256": hashlib.sha256(Path(launcher).read_bytes()).hexdigest(), "fixtures": decisions}, sort_keys=True))
print("local artifact diagnostic passed")
